{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameScope",
  "mainBinaryName": "FrameScope",
  "version": "1.0.0",
  "identifier": "com.framescope.ui-preview",
  "build": {
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameScope",
        "width": 1230,
        "height": 771,
        "minWidth": 1140,
        "minHeight": 715,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      },
      "csp": "script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "license": "GPL-3.0",
    "licenseFile": "installer/license.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/backend/*": "./",
      "resources/backend/tools/*": "tools/",
      "resources/dependencies/PawnIO/*": "dependencies/PawnIO/",
      "resources/fonts/*": "Fonts/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "template": "installer/installer-branded.nsi"
      }
    }
  }
}
