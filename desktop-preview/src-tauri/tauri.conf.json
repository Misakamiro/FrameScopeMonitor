{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameScope",
  "mainBinaryName": "FrameScope",
  "version": "2.1.2",
  "identifier": "com.framescope.ui-preview",
  "build": {
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameScope",
        "width": 1230,
        "height": 771,
        "minWidth": 1140,
        "minHeight": 715,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "$HOME/**/*.png", "$HOME/**/*.jpg", "$HOME/**/*.jpeg", "$HOME/**/*.webp", "$HOME/**/*.gif", "$HOME/**/*.bmp",
          "$HOME/**/*.mp4", "$HOME/**/*.webm", "$HOME/**/*.mov"
        ]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "license": "GPL-3.0",
    "licenseFile": "installer/license.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/backend/*": "./",
      "resources/backend/tools/*": "tools/",
      "resources/dependencies/PawnIO/*": "dependencies/PawnIO/",
      "resources/fonts/*": "Fonts/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "template": "installer/installer-branded.nsi"
      }
    }
  }
}
