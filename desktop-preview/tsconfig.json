{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@preview/native-core": ["./node_modules/@tauri-apps/api/core.d.ts"]
    }
  },
  "include": ["src/main.tsx", "src/raw.d.ts", "src/preview/**/*.ts", "src/preview/**/*.tsx"],
  "exclude": ["src_old", "src/app", "src/components/components"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
